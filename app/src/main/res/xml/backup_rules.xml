<?xml version="1.0" encoding="utf-8"?>
<!--
   Privacy-first exclusion rules for Android Auto Backup (API <= 30 / legacy fallback).
   All local health databases, DataStore preferences, internal files, and external app files
   are explicitly excluded from cloud backup. Users transfer data manually via encrypted-device
   or password-protected offline storage using the in-app Excel (.xlsx) Export/Import flow.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
